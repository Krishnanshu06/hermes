# Hermes - AI Email Organizer Environment Configuration

# ----------------------------------------
# Google Gemini API
# Get your API key from https://aistudio.google.com/
# ----------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------
# Google OAuth 2.0 (Gmail API)
# Get from Google Cloud Console -> APIs & Services -> Credentials
# ----------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# For local development with FastAPI backend:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ----------------------------------------
# App & Security Configuration
# ----------------------------------------
# Random secret string for JWT session token signing (e.g. openssl rand -hex 32)
JWT_SECRET=super_secret_jwt_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client origin for CORS (Vercel deployment URL or localhost in dev)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
